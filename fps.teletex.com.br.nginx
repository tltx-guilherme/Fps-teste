server {
    listen 80;
    server_name fps.teletex.com.br;

    # Redirect HTTP to HTTPS once the certificate is present.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name fps.teletex.com.br;

    # Usa o wildcard já existente (mesmo padrão do devops.teletex.com.br)
    ssl_certificate     /home/admin_django/.ctltx/cert-tltx.crt;
    ssl_certificate_key /home/admin_django/.ctltx/cert-tltx.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
 
    root /home/admin_django/projetos/fps/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4001; # sem / final para manter o prefixo /api
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Aumentar timeouts para requisições mais longas
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location = / {
        return 302 /login;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
